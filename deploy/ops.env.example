# Copy to a private (0600) ~/.config/bora-bridge/ops.env after resolving exact paths.
# These placeholders are intentionally not runnable deployment settings.
BORA_DATABASE_PATH=/absolute/path/to/live.sqlite
BORA_BACKUP_DIR=/home/example/.local/share/bora-bridge/encrypted-backups
BORA_BACKUP_PUBLIC_KEY=/home/example/.config/bora-bridge/backup-public.pem
BORA_OPS_STATUS_DIR=/home/example/.local/share/bora-bridge/ops
BORA_PUBLIC_URL=https://borabridge.com
# The sandbox requires these exact home-relative locations; use the actual
# service user's home and the project's canonical .wrangler/state/v3/d1 DB.
# Never put the RSA private key on the server. An omitted public-key setting
# means LOCAL 0600 plaintext backups only when invoking the Python tool directly.
# The scheduled sandbox REQUIRES the public key and cannot fall back to plaintext.
