LOCAL_LLM_API_KEY=
LOCAL_LLM_ADMIN_TOKEN=
LOCAL_LLM_DEFAULT_MODEL=exaone4.0:1.2b-q4
LOCAL_LLM_STATE_PATH=./runtime/model-state.json
LOCAL_LLM_MODEL_LOAD_TIMEOUT_SECONDS=900
LOCAL_LLM_MAX_INPUT_CHARS=48000
LOCAL_LLM_INFERENCE_TIMEOUT_SECONDS=20
LOCAL_LLM_MAX_CONCURRENT=1
LOCAL_LLM_MAX_QUEUED=4
LOCAL_LLM_QUEUE_TIMEOUT_SECONDS=2
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_AUTOLOAD=true
OLLAMA_KEEP_ALIVE=10m
