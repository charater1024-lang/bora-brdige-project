AI_TIMEOUT_MS=25000
# Emergency master switch. When true, every paid AI provider stays OFF even if
# its key and per-provider setting are present. Keep true until the developer
# console's explicit per-provider opt-in controls are ready for use.
DISABLE_BILLABLE_APIS=true

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini generateContent API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Anthropic Claude Messages API
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_BASE_URL=https://api.anthropic.com/v1

# OpenAI-compatible local endpoint (for example Ollama, LM Studio, or vLLM).
# Public internet endpoints are rejected; use loopback or an RFC1918 private IP.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11435/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_ADMIN_TOKEN=
LOCAL_LLM_MODEL=exaone4.0:1.2b-q4

# Official public-data adapters
KOREA_EXIM_API_KEY=
DART_API_KEY=
BOK_ECOS_API_KEY=
FINLIFE_API_KEY=
DATA_GO_KR_API_KEY=
BIZINFO_API_KEY=
YOUTH_CENTER_API_KEY=
WORK24_API_KEY=
SEOUL_OPEN_DATA_API_KEY=
LAW_OPEN_API_KEY=
KOSIS_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
# Optional secret for an external/public scheduler. The bundled remote timer
# reads this value without exposing it to the browser. Configure its
# PUBLIC_DATA_REFRESH_URL to the deployment that owns the production D1; do not
# point the production timer at a separate local wrangler --persist-to database.
# Required for /api/public-data/scheduled; use at least 32 random characters.
SCHEDULER_SECRET=

# Optional local-only compatibility bridge for public providers whose legacy TLS
# cannot be reached by the Workers runtime. Bind the bundled proxy to loopback.
PUBLIC_API_PROXY_URL=
PUBLIC_API_PROXY_TOKEN=
PUBLIC_API_PROXY_PORT=3101

# Developer console security. Keep the encryption key server-only and use at
# least 32 random characters. Administrators must be explicitly configured as
# immutable provider:subject identities; there is no built-in administrator.
DEVELOPER_SETTINGS_ENCRYPTION_KEY=
# Required to enable the developer console; subjects are case-sensitive.
# Example format only: naver:provider-subject
DEVELOPER_ADMIN_IDENTITIES=
# Public contact displayed on privacy/terms pages. Set a verified mailbox before
# deploying; keep personal addresses out of source. This value is public, not a key.
LEGAL_CONTACT_EMAIL=

# Authentication mode: sites (ChatGPT/SIWC) | external (Google/Kakao/Naver)
# The production template uses one canonical HTTPS origin and ignores forwarded
# host headers. For local-only development, override APP_BASE_URL and AUTH_MODE
# in the uncommitted .env.local file.
AUTH_MODE=external
APP_BASE_URL=https://borabridge.com
AUTH_SESSION_TTL_SECONDS=28800
# Development only: permits Kakao/Naver on an RFC1918 LAN origin over HTTP.
# Never enable this with real member or financial data.
AUTH_ALLOW_INSECURE_LAN=false

# Google OAuth (Google rejects a raw non-loopback IP redirect URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Kakao Login
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://borabridge.com/api/auth/callback/kakao

# Naver Login
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=https://borabridge.com/api/auth/callback/naver
