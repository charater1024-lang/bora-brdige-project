# Byte thresholds. Defaults are 2.5 GiB warning and 3.5 GiB controlled restart.
BORA_MEMORY_WATCHDOG_WARNING_BYTES=2684354560
BORA_MEMORY_WATCHDOG_RESTART_BYTES=3758096384

# An emergency reading bypasses the consecutive-sample wait, but still obeys
# the shared lock, cooldown, daily budget and dry-run setting.
BORA_MEMORY_WATCHDOG_EMERGENCY_BYTES=4026531840

# A restart requires this many consecutive samples above RESTART_BYTES.
BORA_MEMORY_WATCHDOG_REQUIRED_SAMPLES=2

# At most two restart attempts per 24 hours, never less than six hours apart.
BORA_MEMORY_WATCHDOG_COOLDOWN_SECONDS=21600
BORA_MEMORY_WATCHDOG_BUDGET_WINDOW_SECONDS=86400
BORA_MEMORY_WATCHDOG_MAX_RESTARTS_PER_WINDOW=2

# Emit a low-volume watchdog telemetry event once per hour.
BORA_MEMORY_WATCHDOG_OBSERVATION_INTERVAL_SECONDS=3600

# Controlled restarts are enabled in production. The watchdog still requires
# sustained samples and obeys the shared lock, cooldown and daily restart
# budget above before it can restart the web service.
BORA_MEMORY_WATCHDOG_DRY_RUN=0
