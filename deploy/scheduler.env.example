# The scheduler must call the same deployment that owns the production D1.
# The timer and web service share one host, so keep this loopback URL private.
PUBLIC_DATA_REFRESH_URL=http://127.0.0.1:3000

# Use an HTTPS origin only when the scheduler runs on another trusted host and
# that origin is backed by the exact same production data store.

# Use the same server-only value configured as SCHEDULER_SECRET in that
# deployment. Generate at least 32 random characters and never commit the real
# secret.
SCHEDULER_SECRET=
